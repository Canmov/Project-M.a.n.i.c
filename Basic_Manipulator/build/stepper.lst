  38:Core/Src/stepper.c **** void inv_kin(int x, int y, int z)
  39:Core/Src/stepper.c **** {
  40:Core/Src/stepper.c **** 	float alfa, betta, gamma, delta; // Выходные значения
  41:Core/Src/stepper.c **** 	float L, P, c, b1, b2; // Промежуточные переменные
  42:Core/Src/stepper.c **** 
  43:Core/Src/stepper.c **** 	alfa = atan2f(x, y) + pi/2; // расчёт угла нулевого звена поворта б
  44:Core/Src/stepper.c **** 
  45:Core/Src/stepper.c ****     P = sqrt(pow(x, 2) + pow(y, 2)) - 5; // расчёт проекции на плоскость �
  46:Core/Src/stepper.c **** 	L = sqrt(pow(P, 2) + pow(A - D - z, 2)); // расчёт расстояния между перв�
  47:Core/Src/stepper.c ****     
  48:Core/Src/stepper.c **** 	/*поиск угла между первым и вторым звеньями*/
  49:Core/Src/stepper.c **** 	c = acos((pow(B, 2) +  pow(C, 2) - pow(L, 2))  /  (2 * B * C));
  50:Core/Src/stepper.c ****     
  51:Core/Src/stepper.c **** 	gamma = pi - c; // угол второго звена
  52:Core/Src/stepper.c ****     
  53:Core/Src/stepper.c **** 	/*промежуточные углы для нахождения углов первого и т�
  54:Core/Src/stepper.c **** 	b1 = acos((pow(B, 2) + pow(L, 2) - pow(C, 2))  /  (2 * B * L));
  55:Core/Src/stepper.c **** 	b2 = atan((z + D - A) / P);
  56:Core/Src/stepper.c **** 
  57:Core/Src/stepper.c **** 	betta = b1 + b2; // угол первого звена
  58:Core/Src/stepper.c **** 
  59:Core/Src/stepper.c **** 	delta = pi - b1 - b2 - c; // угол третьего звена
  60:Core/Src/stepper.c ****     
  61:Core/Src/stepper.c **** 	/*перевод из радиан в углы*/
  62:Core/Src/stepper.c **** 	alfa = alfa * 180 / pi;
  63:Core/Src/stepper.c **** 	betta = betta * 180 / pi;
  64:Core/Src/stepper.c **** 	gamma = gamma * 180 / pi;
  65:Core/Src/stepper.c **** 	delta = delta * 180 / pi;
  66:Core/Src/stepper.c ****     
  67:Core/Src/stepper.c **** 	/*установка двигателей по найденным углам*/
  68:Core/Src/stepper.c **** 	Stepper_Angle(0, alfa);
  69:Core/Src/stepper.c **** 	Servo_SetAngle(0, delta);
  70:Core/Src/stepper.c **** 	Stepper_Angle(2, gamma);
  71:Core/Src/stepper.c **** 	Stepper_Angle(1, betta);
  72:Core/Src/stepper.c **** 	
  73:Core/Src/stepper.c **** 	CLAW_CLOSE; // захват объекта
  74:Core/Src/stepper.c **** 	
  75:Core/Src/stepper.c **** }
