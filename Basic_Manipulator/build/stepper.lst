 109:Core/Src/stepper.c **** void Stepper_Angle(uint8_t Link, float Angle) // принимаем номер звена и зад
 110:Core/Src/stepper.c **** {
 111:Core/Src/stepper.c **** 	/*Вспомогательные переменные*/ 
 112:Core/Src/stepper.c **** 	int max_angle = 0, min_angle = 0; // для определения ограничений по у�
 113:Core/Src/stepper.c **** 	uint8_t gear_ratio = 0;           // для определения передаточного чи
 114:Core/Src/stepper.c ****   	bool Direction = 0;               // для направления вращения
 115:Core/Src/stepper.c **** 
 116:Core/Src/stepper.c ****    /*Опреатор выбора макс. и мин. угла передвижения звен�
 117:Core/Src/stepper.c ****     в соответствии с заданным номером звена*/ 
 118:Core/Src/stepper.c **** 	switch (Link) 
 119:Core/Src/stepper.c **** 	{                
 120:Core/Src/stepper.c **** 	case 0:
 121:Core/Src/stepper.c **** 		max_angle = 360, min_angle = 0, gear_ratio = GEAR_RATIO_0; 
 122:Core/Src/stepper.c **** 		break;
 123:Core/Src/stepper.c **** 	case 1:
 124:Core/Src/stepper.c **** 		max_angle = 180, min_angle = 0, gear_ratio = GEAR_RATIO_1;
 125:Core/Src/stepper.c **** 		break;
 126:Core/Src/stepper.c **** 	case 2:
 127:Core/Src/stepper.c **** 		max_angle = 180, min_angle = 0, gear_ratio = GEAR_RATIO_2;
